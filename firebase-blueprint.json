{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Private profile information for customers.",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "isAdmin": { "type": "boolean" }
      },
      "required": ["fullName", "email"]
    },
    "Product": {
      "title": "Product",
      "description": "Store items for sale.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "image": { "type": "string" }
      },
      "required": ["name", "price", "image"]
    },
    "Category": {
      "title": "Category",
      "description": "Product groupings.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "image": { "type": "string" },
        "platform": { "type": "string", "enum": ["web", "mobile", "both"] }
      },
      "required": ["name", "slug"]
    },
    "Banner": {
      "title": "Banner",
      "description": "Promotional images for hero slider.",
      "type": "object",
      "properties": {
        "image": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "active": { "type": "boolean" },
        "platform": { "type": "string", "enum": ["web", "mobile", "both"] }
      },
      "required": ["image", "active", "platform"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase records.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "customerName": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "discount": { "type": "number" },
        "couponCode": { "type": "string" },
        "subtotal": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "processing", "completed", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "items", "total", "status", "createdAt"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Discount codes for promotions.",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "type": { "type": "string", "enum": ["percentage", "fixed"] },
        "value": { "type": "number" },
        "minOrder": { "type": "number" },
        "expiryDate": { "type": "string", "format": "date-time" },
        "active": { "type": "boolean" },
        "usageLimit": { "type": "number" },
        "usageCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code", "type", "value", "active", "createdAt"]
    },
    "AppConfig": {
      "title": "App Config",
      "description": "Global application settings.",
      "type": "object",
      "properties": {
        "heroImageWeb": { "type": "string" },
        "heroImageMobile": { "type": "string" }
      }
    },
    "Testimonial": {
      "title": "Customer Testimonial",
      "description": "Reviews and feedback from customers.",
      "type": "object",
      "properties": {
        "customerName": { "type": "string" },
        "content": { "type": "string" },
        "rating": { "type": "number" },
        "date": { "type": "string", "format": "date" }
      },
      "required": ["customerName", "content", "rating", "date"]
    },
    "NotificationSettings": {
      "title": "Notification Settings",
      "description": "Admin configuration for multi-stage cart reminders.",
      "type": "object",
      "properties": {
        "cartReminderEnabled": { "type": "boolean" },
        "reminders": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "delayMinutes": { "type": "number" },
              "title": { "type": "string" },
              "message": { "type": "string" }
            }
          }
        }
      }
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Platform-specific broadcast message or popup for all users with size controls.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["popup", "banner"] },
        "size": { "type": "string", "enum": ["sm", "md", "lg", "xl"] },
        "position": { "type": "string", "enum": ["top", "center", "bottom"] },
        "platform": { "type": "string", "enum": ["web", "mobile", "both"] },
        "active": { "type": "boolean" },
        "maxViews": { "type": "number" },
        "autoHideSeconds": { "type": "number" },
        "startDate": { "type": "string", "format": "date-time" },
        "endDate": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "message", "type", "platform", "active"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles keyed by UID."
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Available products."
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Product categories."
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer orders."
    },
    "/coupons/{couponId}": {
      "schema": "Coupon",
      "description": "Discount coupons."
    },
    "/config/general": {
      "schema": "AppConfig",
      "description": "Global settings."
    },
    "/config/notifications": {
      "schema": "NotificationSettings",
      "description": "Notification configuration."
    },
    "/announcements/{announcementId}": {
      "schema": "Announcement",
      "description": "Global announcements and popups."
    },
    "/banners/{bannerId}": {
      "schema": "Banner",
      "description": "Hero slider images."
    },
    "/testimonials/{testimonialId}": {
      "schema": "Testimonial",
      "description": "Customer reviews."
    }
  }
}
